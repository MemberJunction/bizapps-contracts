{
  "name": "mj-bizapps-contracts",
  "version": "1.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "description": "Template repository for MemberJunction Open Apps - clone, rename, fill in. See README.md and docs/.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n[ERROR] Dependencies not installed. Run: pnpm install\\n'); process.exit(1); }\"",
    "init": "node scripts/init-template.mjs",
    "build": "pnpm run build:stream",
    "build:stream": "turbo --log-order=stream build",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-biz-apps/contracts-*\"",
    "test": "turbo --log-order=stream test --filter=\"@mj-biz-apps/contracts-*\"",
    "mj:migrate": "mj migrate --schema __mj_BizAppsContracts --dir ./migrations",
    "mj:codegen": "mj codegen",
    "mj:migrate:convert": "mj migrate convert --source-dir ./migrations --output-dir ./migrations-pg --schema __mj_BizAppsContracts",
    "change": "changeset",
    "version": "changeset version",
    "commitpush": "node ci/commit_push.mjs",
    "mergemain": "node ci/merge_main.mjs",
    "mergemain:update-lock": "node ci/merge_main_and_update_lock.mjs",
    "test:unit": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-contracts"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@angular/common": "21.1.3",
    "@angular/compiler": "21.1.3",
    "@angular/compiler-cli": "21.1.3",
    "@angular/core": "21.1.3",
    "@angular/forms": "21.1.3",
    "@changesets/cli": "^2.29.8",
    "@memberjunction/actions": "^6.1.0-edge.2",
    "@memberjunction/actions-base": "^6.1.0-edge.2",
    "@memberjunction/cli": "^6.1.0-edge.2",
    "@memberjunction/core": "^6.1.0-edge.2",
    "@memberjunction/core-entities": "^6.1.0-edge.2",
    "@memberjunction/global": "^6.1.0-edge.2",
    "@memberjunction/ng-base-forms": "^6.1.0-edge.2",
    "@memberjunction/ng-entity-viewer": "^6.1.0-edge.2",
    "@memberjunction/ng-link-directives": "^6.1.0-edge.2",
    "@memberjunction/ng-shared": "^6.1.0-edge.2",
    "@memberjunction/ng-ui-components": "^6.1.0-edge.2",
    "@memberjunction/server": "^6.1.0-edge.2",
    "@memberjunction/sqlserver-dataprovider": "^6.1.0-edge.2",
    "@memberjunction/testing-integration": "^6.1.0-edge.2",
    "@types/node": "^22.10.0",
    "simple-git": "^3.31.1",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.7.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "overrides": {
      "@angular/animations": "21.1.3",
      "@angular/build": "21.1.3",
      "@angular/cli": "21.1.3",
      "@angular/common": "21.1.3",
      "@angular/compiler": "21.1.3",
      "@angular/compiler-cli": "21.1.3",
      "@angular/core": "21.1.3",
      "@angular/forms": "21.1.3",
      "@angular/localize": "21.1.3",
      "@angular/platform-browser": "21.1.3",
      "@angular/platform-browser-dynamic": "21.1.3",
      "@angular/router": "21.1.3",
      "@angular-devkit/build-angular": "21.1.3",
      "@memberjunction/core": "^6.1.0-edge.2",
      "@memberjunction/global": "^6.1.0-edge.2"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  }
}
